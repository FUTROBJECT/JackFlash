{
  "$schema": "https://design-tokens.org/schema.json",
  "$description": "JackFlash design tokens. Foundation extracted from Fauna Robotics' live stylesheet and adapted for JackFlash (kids' math-practice app). W3C-style format; compiles to tokens.css via Style Dictionary or similar.",
  "color": {
    "primitive": {
      "ink":   { "$value": "#180102", "$type": "color", "$description": "Warm near-black (Fauna --black--900)" },
      "cream": { "$value": "#f8f0e3", "$type": "color", "$description": "Warm off-white base canvas (Fauna --white--900)" },
      "cream-lift": { "$value": "#fffdf9", "$type": "color" },
      "clay": {
        "50":  { "$value": "#ece4d7", "$type": "color" },
        "100": { "$value": "#ded2c0", "$type": "color" },
        "200": { "$value": "#aca396", "$type": "color" },
        "300": { "$value": "#938a7d", "$type": "color" },
        "400": { "$value": "#7a7164", "$type": "color" },
        "500": { "$value": "#60574a", "$type": "color" },
        "600": { "$value": "#473e31", "$type": "color" }
      },
      "brand": {
        "coral":  { "$value": "#f16b46", "$type": "color", "$description": "Fauna --brand--orange" },
        "teal":   { "$value": "#3dac91", "$type": "color", "$description": "Fauna --brand--green" },
        "ocean":  { "$value": "#63a4bc", "$type": "color", "$description": "Fauna --brand--blue" },
        "clayred":{ "$value": "#a7625a", "$type": "color", "$description": "Fauna --brand--brown-bright" },
        "khaki":  { "$value": "#8d8465", "$type": "color", "$description": "Fauna --brand--khaki" },
        "pink":   { "$value": "#e0a5cf", "$type": "color", "$description": "Fauna --brand--pink" },
        "gold":   { "$value": "#dbb154", "$type": "color", "$description": "Fauna --brand--yellow" }
      }
    },
    "semantic": {
      "bg":            { "$value": "{color.primitive.cream}", "$type": "color" },
      "surface":       { "$value": "{color.primitive.cream-lift}", "$type": "color" },
      "surface-sunken":{ "$value": "{color.primitive.clay.50}", "$type": "color" },
      "border":        { "$value": "rgba(24,1,2,0.10)", "$type": "color" },
      "border-strong": { "$value": "rgba(24,1,2,0.20)", "$type": "color" },
      "ink":           { "$value": "{color.primitive.ink}", "$type": "color" },
      "ink-muted":     { "$value": "rgba(24,1,2,0.60)", "$type": "color" },
      "ink-subtle":    { "$value": "rgba(24,1,2,0.40)", "$type": "color" },
      "on-bright":     { "$value": "{color.primitive.ink}", "$type": "color", "$description": "Text on coral/teal/gold fills — ink for AA contrast" },
      "on-dark":       { "$value": "{color.primitive.cream}", "$type": "color" },
      "primary":       { "$value": "{color.primitive.brand.coral}", "$type": "color" },
      "primary-hover": { "$value": "{color.primitive.ink}", "$type": "color" },
      "secondary":     { "$value": "{color.primitive.brand.ocean}", "$type": "color" },
      "success":       { "$value": "{color.primitive.brand.teal}", "$type": "color" },
      "info":          { "$value": "{color.primitive.brand.ocean}", "$type": "color" },
      "warning":       { "$value": "{color.primitive.brand.gold}", "$type": "color" },
      "danger":        { "$value": "{color.primitive.brand.clayred}", "$type": "color" },
      "correct":       { "$value": "{color.primitive.brand.teal}", "$type": "color" },
      "incorrect":     { "$value": "{color.primitive.brand.clayred}", "$type": "color" },
      "streak":        { "$value": "{color.primitive.brand.gold}", "$type": "color" }
    }
  },
  "font": {
    "family": {
      "display": { "$value": "Fraunces, 'ABC Maxi', Georgia, serif", "$type": "fontFamily", "$description": "Fauna uses ABC Maxi; Fraunces is a free stand-in" },
      "body":    { "$value": "'Hanken Grotesk', Matter, system-ui, sans-serif", "$type": "fontFamily", "$description": "Fauna uses Matter; Hanken Grotesk is a free stand-in" },
      "numeric": { "$value": "'Hanken Grotesk', Matter, ui-monospace, monospace", "$type": "fontFamily" }
    },
    "size": {
      "display":  { "$value": "clamp(2.5rem, 6vw, 3.75rem)", "$type": "dimension" },
      "h1":       { "$value": "2.375rem", "$type": "dimension" },
      "h2":       { "$value": "2rem", "$type": "dimension" },
      "h3":       { "$value": "1.5rem", "$type": "dimension" },
      "h4":       { "$value": "1.125rem", "$type": "dimension" },
      "body-lg":  { "$value": "1.125rem", "$type": "dimension" },
      "body":     { "$value": "1rem", "$type": "dimension" },
      "sm":       { "$value": "0.875rem", "$type": "dimension" },
      "caption":  { "$value": "0.75rem", "$type": "dimension" }
    },
    "weight": {
      "regular":  { "$value": 400, "$type": "fontWeight" },
      "medium":   { "$value": 500, "$type": "fontWeight" },
      "semibold": { "$value": 600, "$type": "fontWeight" },
      "bold":     { "$value": 700, "$type": "fontWeight" }
    },
    "leading": {
      "tight":  { "$value": 1.1, "$type": "number" },
      "snug":   { "$value": 1.25, "$type": "number" },
      "normal": { "$value": 1.55, "$type": "number" }
    }
  },
  "space": {
    "0":  { "$value": "0",      "$type": "dimension" },
    "1":  { "$value": "0.25rem","$type": "dimension" },
    "2":  { "$value": "0.5rem", "$type": "dimension" },
    "3":  { "$value": "0.75rem","$type": "dimension" },
    "4":  { "$value": "1rem",   "$type": "dimension" },
    "5":  { "$value": "1.25rem","$type": "dimension" },
    "6":  { "$value": "1.5rem", "$type": "dimension" },
    "8":  { "$value": "2rem",   "$type": "dimension" },
    "10": { "$value": "2.5rem", "$type": "dimension" },
    "12": { "$value": "3rem",   "$type": "dimension" },
    "16": { "$value": "4rem",   "$type": "dimension" },
    "20": { "$value": "5rem",   "$type": "dimension" }
  },
  "radius": {
    "sm":     { "$value": "0.5rem", "$type": "dimension" },
    "md":     { "$value": "1rem",   "$type": "dimension" },
    "lg":     { "$value": "1.5rem", "$type": "dimension" },
    "xl":     { "$value": "2rem",   "$type": "dimension" },
    "2xl":    { "$value": "2.5rem", "$type": "dimension" },
    "pill":   { "$value": "100rem", "$type": "dimension" },
    "circle": { "$value": "50%",    "$type": "dimension" }
  },
  "shadow": {
    "xs": { "$value": "0 0 0 1px rgba(24,1,2,0.06)", "$type": "shadow" },
    "sm": { "$value": "0 1px 3px rgba(24,1,2,0.10), 0 0 0 1px rgba(24,1,2,0.06)", "$type": "shadow" },
    "md": { "$value": "0 6px 20px rgba(24,1,2,0.10)", "$type": "shadow" },
    "lg": { "$value": "0 16px 40px rgba(24,1,2,0.14)", "$type": "shadow" },
    "glow-flash": { "$value": "0 0 80px rgba(241,107,70,0.35)", "$type": "shadow" }
  },
  "motion": {
    "ease-out":    { "$value": "cubic-bezier(0.22, 1, 0.36, 1)", "$type": "cubicBezier" },
    "ease-spring": { "$value": "cubic-bezier(0.34, 1.56, 0.64, 1)", "$type": "cubicBezier" },
    "duration": {
      "fast": { "$value": "120ms", "$type": "duration" },
      "base": { "$value": "200ms", "$type": "duration" },
      "slow": { "$value": "320ms", "$type": "duration" }
    }
  }
}
