{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "jackflash-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "jackflash-dev-tester",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:tester"
      ],
      "port": 5173
    },
    {
      "name": "jackflash-web-prod",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173,
      "url": "http://localhost:4173"
    }
  ]
}
